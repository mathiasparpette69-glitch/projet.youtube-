@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');


/* =========================================================
   SKÖLL — PREMIUM 3D STREETWEAR
   ========================================================= */


/* =========================
   VARIABLES
   ========================= */

:root {

    --bg: #050505;
    --bg-light: #0b0b0b;
    --card: #101010;

    --white: #ffffff;
    --gray: #a0a0a0;
    --dark-gray: #1c1c1c;

    --accent: #ffffff;

    --radius: 20px;

    --shadow:
        0 20px 60px rgba(0, 0, 0, 0.65);

    --transition:
        0.35s cubic-bezier(0.22, 1, 0.36, 1);
}


/* =========================
   RESET
   ========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {

    font-family: 'Inter', sans-serif;

    background:
        radial-gradient(
            circle at 50% -20%,
            #252525 0%,
            #090909 35%,
            #050505 70%
        );

    color: var(--white);

    min-height: 100vh;

    overflow-x: hidden;
}


/* =========================
   SELECTION
   ========================= */

::selection {
    background: white;
    color: black;
}


/* =========================
   SCROLLBAR
   ========================= */

::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: #050505;
}

::-webkit-scrollbar-thumb {

    background: #333;

    border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
    background: #666;
}


/* =========================
   GLOBAL
   ========================= */

a {
    color: inherit;
    text-decoration: none;
}


ul {
    list-style: none;
}


img {

    max-width: 100%;

    display: block;

    object-fit: cover;
}


section {

    width: min(1200px, 90%);

    margin: auto;

    padding: 120px 0;
}


h1,
h2,
h3 {

    line-height: 1;

    letter-spacing: -0.04em;
}


h2 {

    font-size: clamp(2.2rem, 6vw, 4.5rem);

    margin-bottom: 30px;
}


p {

    color: var(--gray);

    line-height: 1.7;
}


/* =========================
   HEADER
   ========================= */

header {

    position: fixed;

    top: 0;
    left: 0;

    width: 100%;

    z-index: 1000;

    padding: 20px 5%;

    backdrop-filter: blur(20px);

    background: rgba(5, 5, 5, 0.65);

    border-bottom:
        1px solid rgba(255, 255, 255, 0.08);
}


header nav {

    max-width: 1300px;

    margin: auto;

    display: flex;

    justify-content: space-between;

    align-items: center;
}


header nav > a {

    font-size: 1.5rem;

    font-weight: 900;

    letter-spacing: -0.08em;

    position: relative;
}


header nav > a::after {

    content: "";

    position: absolute;

    width: 6px;
    height: 6px;

    background: white;

    border-radius: 50%;

    right: -10px;
    bottom: 5px;
}


header ul {

    display: flex;

    gap: 35px;
}


header ul a {

    color: #aaa;

    font-size: 0.85rem;

    font-weight: 600;

    transition: var(--transition);
}


header ul a:hover {

    color: white;

    text-shadow:
        0 0 15px rgba(255,255,255,0.5);
}


/* =========================
   HERO
   ========================= */

#accueil {

    width: 100%;

    min-height: 100vh;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: center;

    text-align: center;

    position: relative;

    overflow: hidden;

    padding: 150px 5% 100px;
}


/* Glow */

#accueil::before {

    content: "";

    position: absolute;

    width: 500px;
    height: 500px;

    background: white;

    opacity: 0.04;

    border-radius: 50%;

    filter: blur(100px);

    animation:
        heroGlow 6s ease-in-out infinite alternate;
}


@keyframes heroGlow {

    from {
        transform: scale(0.8);
    }

    to {
        transform: scale(1.2);
    }
}


#accueil p:first-child {

    font-size: 0.75rem;

    letter-spacing: 0.35em;

    color: #aaa;

    margin-bottom: 25px;
}


#accueil h1 {

    font-size:
        clamp(5rem, 18vw, 13rem);

    font-weight: 900;

    letter-spacing: -0.1em;

    position: relative;

    z-index: 2;

    background:
        linear-gradient(
            180deg,
            #ffffff 0%,
            #888888 50%,
            #222222 100%
        );

    -webkit-background-clip: text;

    color: transparent;

    text-shadow:
        0 25px 50px rgba(0,0,0,0.8);

    animation:
        titleFloat 5s ease-in-out infinite;
}


@keyframes titleFloat {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-12px);
    }
}


#accueil h2 {

    font-size:
        clamp(1.2rem, 4vw, 2rem);

    margin-top: 10px;

    color: #ddd;

    font-weight: 700;
}


#accueil p:not(:first-child) {

    max-width: 600px;

    margin: 25px auto 40px;
}


/* =========================
   BUTTONS
   ========================= */

#accueil a {

    display: inline-block;

    padding: 16px 28px;

    margin: 5px;

    border-radius: 50px;

    font-weight: 700;

    font-size: 0.85rem;

    transition: var(--transition);

    position: relative;

    overflow: hidden;
}


#accueil a:first-of-type {

    background: white;

    color: black;

    box-shadow:
        0 10px 40px rgba(255,255,255,0.15);
}


#accueil a:first-of-type:hover {

    transform:
        translateY(-5px)
        scale(1.04);

    box-shadow:
        0 20px 60px rgba(255,255,255,0.25);
}


#accueil a:last-of-type {

    border:
        1px solid #333;

    background:
        rgba(255,255,255,0.03);
}


#accueil a:last-of-type:hover {

    background: white;

    color: black;

    transform:
        translateY(-5px);
}


/* =========================
   COLLECTION
   ========================= */

#collection {

    position: relative;
}


#collection > p {

    margin-bottom: 50px;
}


/* Product grid */

#collection {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 25px;
}


#collection > h2,
#collection > p {

    grid-column: 1 / -1;
}


/* Product cards */

#collection article {

    background:

        linear-gradient(
            145deg,
            #181818,
            #080808
        );

    border:
        1px solid rgba(255,255,255,0.08);

    border-radius: var(--radius);

    padding: 18px;

    position: relative;

    overflow: hidden;

    transition:
        transform var(--transition),
        box-shadow var(--transition),
        border var(--transition);

    transform-style: preserve-3d;

    box-shadow:
        0 15px 40px rgba(0,0,0,0.4);
}


/* 3D hover */

#collection article:hover {

    transform:
        translateY(-15px)
        perspective(1000px)
        rotateX(3deg)
        rotateY(-3deg);

    border-color:
        rgba(255,255,255,0.25);

    box-shadow:

        0 35px 80px rgba(0,0,0,0.8),

        0 0 40px rgba(255,255,255,0.04);
}


#collection article::before {

    content: "";

    position: absolute;

    top: -100px;
    right: -100px;

    width: 200px;
    height: 200px;

    border-radius: 50%;

    background: white;

    opacity: 0.03;

    filter: blur(40px);
}


#collection article img {

    width: 100%;

    aspect-ratio: 1 / 1.15;

    border-radius: 15px;

    margin-bottom: 20px;

    transition: var(--transition);
}


#collection article:hover img {

    transform:
        scale(1.04);

    filter:
        brightness(1.08);
}


#collection article h3 {

    font-size: 1.2rem;

    margin-bottom: 10px;
}


#collection article p {

    margin-bottom: 12px;
}


#collection article p:nth-of-type(2) {

    color: white;

    font-weight: 800;

    font-size: 1.1rem;
}


/* =========================
   SELECT
   ========================= */

select {

    width: 100%;

    padding: 13px;

    background: #090909;

    color: white;

    border:
        1px solid #333;

    border-radius: 10px;

    margin: 10px 0 15px;

    outline: none;

    cursor: pointer;
}


select:focus {

    border-color: white;
}


/* =========================
   PRODUCT BUTTON
   ========================= */

#collection button {

    width: 100%;

    padding: 14px;

    border: none;

    border-radius: 10px;

    background: white;

    color: black;

    font-weight: 800;

    cursor: pointer;

    transition: var(--transition);
}


#collection button:hover {

    transform:
        translateY(-3px);

    box-shadow:
        0 15px 30px rgba(255,255,255,0.15);
}


/* =========================
   ABOUT
   ========================= */

#apropos {

    text-align: center;

    max-width: 900px;
}


#apropos p {

    max-width: 700px;

    margin: 15px auto;
}


/* =========================
   GALERIE
   ========================= */

#galerie {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;
}


#galerie h2 {

    grid-column:
        1 / -1;
}


#galerie figure {

    position: relative;

    overflow: hidden;

    border-radius: 18px;

    background: #111;

    border:
        1px solid #222;

    transition: var(--transition);
}


#galerie figure:hover {

    transform:
        translateY(-10px)
        scale(1.02);

    box-shadow:
        var(--shadow);
}


#galerie img {

    width: 100%;

    aspect-ratio: 1 / 1.2;

    transition:
        transform 0.8s
        cubic-bezier(.2,.8,.2,1);
}


#galerie figure:hover img {

    transform: scale(1.1);
}


#galerie figcaption {

    position: absolute;

    bottom: 0;
    left: 0;

    width: 100%;

    padding: 25px 20px;

    background:
        linear-gradient(
            transparent,
            rgba(0,0,0,0.9)
        );

    font-weight: 700;
}


/* =========================
   PANIER
   ========================= */

#panier {

    max-width: 800px;

    text-align: center;

    background:

        linear-gradient(
            145deg,
            #151515,
            #080808
        );

    border:
        1px solid #222;

    border-radius: 25px;

    padding: 60px 30px;

    box-shadow:
        var(--shadow);
}


#panier p {

    margin: 20px 0;
}


#panier strong {

    color: white;

    font-size: 1.5rem;
}


#panier button {

    padding: 15px 30px;

    border: none;

    border-radius: 50px;

    background: white;

    color: black;

    font-weight: 800;

    cursor: pointer;

    transition: var(--transition);
}


#panier button:hover {

    transform:
        translateY(-5px)
        scale(1.04);

    box-shadow:
        0 15px 40px rgba(255,255,255,0.15);
}


/* =========================
   CONTACT
   ========================= */

#contact {

    max-width: 800px;
}


#contact h2 {

    text-align: center;
}


#contact > p {

    text-align: center;

    margin-bottom: 40px;
}


form {

    display: flex;

    flex-direction: column;

    gap: 10px;
}


label {

    font-size: 0.8rem;

    color: #aaa;

    margin-top: 10px;
}


input,
textarea {

    width: 100%;

    padding: 16px;

    border-radius: 12px;

    border:
        1px solid #292929;

    background: #0d0d0d;

    color: white;

    outline: none;

    font-family: inherit;

    transition: var(--transition);
}


input:focus,
textarea:focus {

    border-color: white;

    box-shadow:
        0 0 20px rgba(255,255,255,0.05);
}


textarea {

    resize: vertical;

    min-height: 150px;
}


form button {

    margin-top: 15px;

    padding: 16px;

    border: none;

    border-radius: 12px;

    background: white;

    color: black;

    font-weight: 800;

    cursor: pointer;

    transition: var(--transition);
}


form button:hover {

    transform:
        translateY(-3px);

    box-shadow:
        0 15px 40px rgba(255,255,255,0.15);
}


/* =========================
   FOOTER
   ========================= */

footer {

    margin-top: 100px;

    padding:
        70px 5%
        30px;

    text-align: center;

    background: #030303;

    border-top:
        1px solid #151515;
}


footer h2 {

    font-size: 3rem;

    margin-bottom: 10px;
}


footer p {

    margin-bottom: 25px;
}


footer nav {

    display: flex;

    justify-content: center;

    flex-wrap: wrap;

    gap: 20px;

    margin: 25px 0;
}


footer nav a {

    color: #777;

    font-size: 0.85rem;

    transition: var(--transition);
}


footer nav a:hover {

    color: white;
}


/* =========================
   VISITOR COUNTER
   ========================= */

#visiteurs {

    width: min(500px, 90%);

    margin: 50px auto 30px;

    padding: 20px;

    border-radius: 15px;

    background:
        rgba(255,255,255,0.03);

    border:
        1px solid #202020;
}


#visiteurs p {

    margin: 0;

    font-size: 0.85rem;
}


#nombre-visiteurs {

    color: white;

    font-weight: 900;

    font-size: 1.1rem;
}


/* =========================
   3D FLOATING EFFECT
   ========================= */

@keyframes floating {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-8px);
    }
}


#panier {

    animation:
        floating 6s ease-in-out infinite;
}


/* =========================
   RESPONSIVE TABLET
   ========================= */

@media (max-width: 900px) {

    header ul {

        gap: 15px;
    }


    #collection {

        grid-template-columns:
            repeat(2, 1fr);
    }


    #galerie {

        grid-template-columns:
            repeat(2, 1fr);
    }

}


/* =========================
   RESPONSIVE MOBILE
   ========================= */

@media (max-width: 650px) {

    section {

        padding: 80px 0;
    }


    header {

        padding: 16px 5%;
    }


    header nav {

        flex-direction: column;

        gap: 15px;
    }


    header ul {

        gap: 12px;

        flex-wrap: wrap;

        justify-content: center;
    }


    header ul a {

        font-size: 0.7rem;
    }


    #accueil {

        padding-top: 160px;
    }


    #accueil h1 {

        font-size:
            clamp(4rem, 25vw, 7rem);
    }


    #collection {

        grid-template-columns: 1fr;
    }


    #galerie {

        grid-template-columns: 1fr;
    }


    #collection article:hover {

        transform:
            translateY(-8px);
    }


    footer {

        margin-top: 50px;
    }

}


/* =========================
   REDUCED MOTION
   ========================= */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {

        animation-duration: 0.01ms !important;

        animation-iteration-count: 1 !important;

        scroll-behavior: auto !important;

        transition-duration: 0.01ms !important;
    }

}
